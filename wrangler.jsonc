{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "site-creator-vinext-starter",
	"compatibility_date": "2026-08-17",
	"observability": {
		"enabled": true,
		"redact_query_string": false
	},
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"routes": [
		{
			"pattern": "plastictopaper.org",
			"zone_name": "plastictopaper.org",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"vars": {
		"CONTACT_TO_EMAIL": "info@plastictopaper.org",
		"SMTP_USER": "info@plastictopaper.org",
		"SMTP_PASS": "bxva invo omqy khlw"
	}
}